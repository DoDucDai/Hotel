# Backend environment variables (sample only)
# Copy this file to `.env` and fill real values locally.

# Required for JWT signing (HS384 requires at least 48 bytes)
JWT_SECRET=replace_with_a_strong_secret_of_at_least_48_bytes

# Comma-separated origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional app/mail settings
APP_FRONTEND_URL=http://localhost:5173
APP_BACKEND_URL=http://localhost:8080
PAYMENT_SANDBOX_SECRET=replace_with_long_sandbox_secret
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
APP_MAIL_FROM=no-reply@hotelbooking.local

# Optional: create first ADMIN automatically on startup (dev bootstrap)
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_NAME=System Admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@hotelbooking.local
APP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Optional: seed demo data for local UI testing (idempotent)
APP_DEMO_SEED_ENABLED=false
APP_DEMO_SEED_PASSWORD=Demo123!
APP_DEMO_SEED_ADMIN_NAME=Demo Admin
APP_DEMO_SEED_ADMIN_EMAIL=demo.admin@hotelbooking.local
APP_DEMO_SEED_HOST_NAME=Demo Host
APP_DEMO_SEED_HOST_EMAIL=demo.host@hotelbooking.local
APP_DEMO_SEED_USER_NAME=Demo User
APP_DEMO_SEED_USER_EMAIL=demo.user@hotelbooking.local
